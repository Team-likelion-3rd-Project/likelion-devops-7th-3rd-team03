apiVersion: batch/v1
kind: Job
metadata:
  name: k6-load-test
spec:
  backoffLimit: 0
  ttlSecondsAfterFinished: 3600
  template:
    spec:
      restartPolicy: Never
      # k6가 redirect 파드와 같은 노드에서 CPU를 나눠 쓰면, 서버 지연과 부하 발생기 몫이 섞인다
      # (prod 바이럴 테스트에서 k6가 뜬 노드가 CPU 100%, #262).
      # 가능하면 redirect 파드가 없는 노드에 띄우고, 그런 노드가 없으면 그냥 뜬다(preferred).
      # k6가 뜬 뒤 HPA가 늘린 redirect 파드가 이 노드로 오는 것은 막지 못한다.
      affinity:
        podAntiAffinity:
          preferredDuringSchedulingIgnoredDuringExecution:
            - weight: 100
              podAffinityTerm:
                labelSelector:
                  matchLabels: { app: redirect-service }
                namespaceSelector: {}   # k6와 redirect의 네임스페이스가 달라도 적용
                topologyKey: kubernetes.io/hostname
      containers:
        - name: k6
          image: grafana/k6:latest
          args:
            - run
            - --out
            - experimental-prometheus-rw
            - /scripts/${SCRIPT_FILE}
          env:
            - name: BASE_URL
              value: "${BASE_URL}"
            - name: SLUG
              value: "${SLUG}"
            - name: SLUGS
              value: "${SLUG}"
            - name: SLUG_PREFIX
              value: "${SLUG_PREFIX}"
            - name: SLUG_COUNT
              value: "${SLUG_COUNT}"
            - name: PEAK_TPS
              value: "${PEAK_TPS}"
            - name: MAX_TPS
              value: "${MAX_TPS}"
            - name: RAMP_DURATION
              value: "${RAMP_DURATION}"
            - name: SPIKE_TPS
              value: "${SPIKE_TPS}"
            - name: TESTID
              value: "${TESTID}"
            - name: VUS
              value: "${VUS}"
            - name: DURATION
              value: "${DURATION}"
            - name: K6_PROMETHEUS_RW_SERVER_URL
              value: "http://kube-prometheus-kube-prome-prometheus.monitoring.svc:9090/api/v1/write"
            # grafana.com 대시보드 19665는 histogram_quantile()로 latency를 조회하는데,
            # 기본 출력(trend stat만 pXX suffix로 분리)은 bucket/le 라벨이 없어서 매칭 안 됨.
            # native histogram으로 내보내야 하고, Prometheus 쪽도 native-histograms
            # feature를 켜야 remote-write로 받아들인다.
            - name: K6_PROMETHEUS_RW_TREND_AS_NATIVE_HISTOGRAM
              value: "true"
          resources:
            # 리소스 상한 없이 두면 고TPS 테스트 중 k6 자체가 노드 메모리를 과점해서
            # 같은 노드의 다른 파드(Grafana 등)가 밀려날 수 있어 명시적으로 제한한다.
            requests: { cpu: 250m, memory: 256Mi }
            limits: { cpu: 1000m, memory: 1Gi }
          volumeMounts:
            - name: script
              mountPath: /scripts
      volumes:
        - name: script
          configMap:
            name: k6-load-test-script
