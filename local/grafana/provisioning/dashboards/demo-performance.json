{
  "title": "shortlink demo overview",
  "uid": "shortlink-demo-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "testid",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(k6_http_reqs_total, testid)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": ["$__all"] }
      }
    ]
  },
  "panels": [
    { "id": 200, "type": "row", "title": "데모 개요 (Overview)", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 } },
    {
      "id": 201,
      "type": "stat",
      "title": "Node 개수",
      "description": "count(kube_node_info): 클러스터 워커 노드 수. Cluster Autoscaler가 노드를 늘리면 값이 올라간다.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [{ "expr": "count(kube_node_info)", "legendFormat": "nodes" }]
    },
    {
      "id": 202,
      "type": "stat",
      "title": "Redirect Pod 개수",
      "description": "kube_horizontalpodautoscaler_status_current_replicas: redirect-service-hpa 현재 파드 수 (min 2 / max 6). 부하 중 값이 올라가면 오토스케일링이 실제로 동작한 것.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "max": 6,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 3 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "expr": "sum(kube_horizontalpodautoscaler_status_current_replicas{horizontalpodautoscaler=\"redirect-service-hpa\"})",
          "legendFormat": "current pods"
        }
      ]
    },
    {
      "id": 203,
      "type": "stat",
      "title": "Cache Hit %",
      "description": "redirect_cache_result_total{result=\"hit\"} 비율. 캐시가 잘 맞을수록 DB 부하 없이 빠르게 응답한다.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "green", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "expr": "100 * sum(rate(redirect_cache_result_total{result=\"hit\", job=\"redirect-service\"}[$__rate_interval])) / sum(rate(redirect_cache_result_total{job=\"redirect-service\"}[$__rate_interval]))",
          "legendFormat": "hit %"
        }
      ]
    },

    { "id": 210, "type": "row", "title": "퍼포먼스 — k6 부하테스트 관측치", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 } },
    {
      "id": 211,
      "type": "timeseries",
      "title": "현재 TPS",
      "description": "k6_http_reqs_total: k6가 실제로 쏜 요청 처리율(클라이언트 관측). load-test/job.yaml.template이 --out experimental-prometheus-rw로 Prometheus에 직접 remote-write.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 10 },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(k6_http_reqs_total{testid=~\"$testid\"}[$__rate_interval]))",
          "legendFormat": "tps"
        }
      ]
    },
    {
      "id": 212,
      "type": "timeseries",
      "title": "지연시간 (p50 / p95 / p99)",
      "description": "k6_http_req_duration_seconds: k6가 Trend를 네이티브 히스토그램으로 remote-write한 것(K6_PROMETHEUS_RW_TREND_AS_NATIVE_HISTOGRAM=true, job.yaml.template 참고). histogram_quantile로 클라이언트 체감 지연시간을 계산.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 10 },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(k6_http_req_duration_seconds{testid=~\"$testid\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(k6_http_req_duration_seconds{testid=~\"$testid\"}[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(k6_http_req_duration_seconds{testid=~\"$testid\"}[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 213,
      "type": "timeseries",
      "title": "성공 / 실패 비율",
      "description": "k6_http_reqs_total을 expected_response(k6 체크 기준 기대한 응답인지)로 나눈 비율. 분자에 `or vector(0)`을 붙여서 실패가 0건이어도 0% 선이 그대로 보이게 함 — 실패가 없으면 그냥 no data로 빈 패널이 되는 문제 방지.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 10 },
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100, "color": { "mode": "palette-classic" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "success %" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          },
          {
            "matcher": { "id": "byName", "options": "fail %" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          }
        ]
      },
      "targets": [
        {
          "expr": "100 * (sum(rate(k6_http_reqs_total{testid=~\"$testid\", expected_response=\"true\"}[$__rate_interval])) or vector(0)) / sum(rate(k6_http_reqs_total{testid=~\"$testid\"}[$__rate_interval]))",
          "legendFormat": "success %"
        },
        {
          "expr": "100 * (sum(rate(k6_http_reqs_total{testid=~\"$testid\", expected_response=\"false\"}[$__rate_interval])) or vector(0)) / sum(rate(k6_http_reqs_total{testid=~\"$testid\"}[$__rate_interval]))",
          "legendFormat": "fail %"
        }
      ]
    },

    { "id": 220, "type": "row", "title": "CPU 사용률 & 부하 분산", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 } },
    {
      "id": 221,
      "type": "timeseries",
      "title": "redirect-service CPU 사용률",
      "description": "process_cpu_usage: 파드별 CPU 사용률(자기 limit 대비 비율, 1.0=limit 100% 소진). up==1로 지금 살아있는 파드만 표시. HPA는 request(500m) 기준 70%에서 스케일아웃한다.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 8, "x": 8, "y": 19 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "targets": [
        {
          "expr": "process_cpu_usage{job=\"redirect-service\"} * on(instance) group_left(pod) (up{job=\"redirect-service\"} == 1)",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 223,
      "type": "timeseries",
      "title": "파드별 부하 분산",
      "description": "redirect_outcome_total을 outcome 구분 없이 파드별로 합산해 100% 스택으로 표시. up==1로 지금 살아있는 파드만 필터링(안 그러면 롤아웃으로 죽은 옛날 파드의 시간범위 내 과거 데이터까지 같이 그려짐). 선들이 비슷한 두께로 나란히 있으면 트래픽이 파드에 고르게 분산되는 것, 한쪽이 넓어지면 쏠림. 파드가 새로 뜨면(오토스케일링) 구간이 하나 더 생긴다.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 19 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": { "stacking": { "mode": "percent", "group": "A" }, "fillOpacity": 30 }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (instance) (rate(redirect_outcome_total{job=\"redirect-service\"}[$__rate_interval])) * on(instance) group_left(pod) (up{job=\"redirect-service\"} == 1)",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 224,
      "type": "timeseries",
      "title": "노드별 CPU 사용률",
      "description": "node_cpu_seconds_total(idle 제외) 기준 노드 실사용률 — cgroup limit이 아니라 물리 코어 기준. 한 노드가 100%에 붙으면 그 위 파드들은 limit을 아무리 올려도 서로 못 벗어난다(노드당 파드 분산이 진짜 이유).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 8, "x": 0, "y": 19 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] },
      "targets": [
        {
          "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[$__rate_interval])) * 100)",
          "legendFormat": "{{instance}}"
        }
      ]
    }
  ]
}
