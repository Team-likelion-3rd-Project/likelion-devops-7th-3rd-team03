{
  "title": "shortlink backend overview",
  "uid": "shortlink-backend-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "job",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(up, job)",
        "refresh": 2,
        "includeAll": false,
        "multi": false
      },
      {
        "name": "instance",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(up{job=\"$job\"}, instance)",
        "refresh": 2,
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    { "id": 100, "type": "row", "title": "JVM / Process", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 } },
    {
      "id": 1,
      "type": "stat",
      "title": "Uptime",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "expr": "process_uptime_seconds{job=\"$job\", instance=~\"$instance\"}", "legendFormat": "{{instance}}" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Live Threads",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "expr": "jvm_threads_live_threads{job=\"$job\", instance=~\"$instance\"}", "legendFormat": "{{instance}}" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "CPU Usage",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0 }, "overrides": [] },
      "targets": [
        { "expr": "process_cpu_usage{job=\"$job\", instance=~\"$instance\"}", "legendFormat": "process {{instance}}" },
        { "expr": "system_cpu_usage{job=\"$job\", instance=~\"$instance\"}", "legendFormat": "system {{instance}}" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "JVM Heap Used",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 7 },
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{area=\"heap\", job=\"$job\", instance=~\"$instance\"}",
          "legendFormat": "{{instance}} {{id}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "HikariCP Connection Pool",
      "description": "hikaricp_connections_*: DB 커넥션 풀 상태 (active/idle/pending/max)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 14 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        { "expr": "hikaricp_connections_active{job=\"$job\", instance=~\"$instance\"}", "legendFormat": "active {{instance}}" },
        { "expr": "hikaricp_connections_idle{job=\"$job\", instance=~\"$instance\"}", "legendFormat": "idle {{instance}}" },
        { "expr": "hikaricp_connections_pending{job=\"$job\", instance=~\"$instance\"}", "legendFormat": "pending {{instance}}" },
        { "expr": "hikaricp_connections_max{job=\"$job\", instance=~\"$instance\"}", "legendFormat": "max {{instance}}" }
      ]
    },
    { "id": 101, "type": "row", "title": "Redirect Service", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 21 } },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Redirect Outcome Rate",
      "description": "redirect_outcome_total: 리다이렉트 요청의 최종 결과 (SUCCESS/NOT_FOUND/EXPIRED/DISABLED)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(redirect_outcome_total{job=\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Cache Result Rate",
      "description": "redirect_cache_result_total: Redis 캐시 조회 결과 (hit/miss/error)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (result) (rate(redirect_cache_result_total{job=\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Cache Lookup Avg Latency",
      "description": "redirect_cache_lookup_duration_seconds: 캐시 조회 평균 레이턴시",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 30 },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "expr": "rate(redirect_cache_lookup_duration_seconds_sum{job=\"$job\"}[$__rate_interval]) / rate(redirect_cache_lookup_duration_seconds_count{job=\"$job\"}[$__rate_interval])",
          "legendFormat": "avg lookup latency"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Click Stats Flush Rate",
      "description": "redirect_click_stats_flush_total: 실시간 통계 Redis flush 성공/실패",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 30 },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (result) (rate(redirect_click_stats_flush_total{job=\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{result}}"
        }
      ]
    }
  ]
}
