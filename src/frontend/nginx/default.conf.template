server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # 응답 헤더에 nginx 버전을 싣지 않는다.
    server_tokens off;

    # 텍스트 계열만 압축한다 (이미지·폰트는 이미 압축돼 있다). html은 기본으로 압축된다.
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/css text/plain text/javascript application/javascript application/json image/svg+xml;

    include /etc/nginx/snippets/security-headers.conf;

    # 백엔드 API. /api/... 경로를 그대로 넘기려고 proxy_pass에 경로를 붙이지 않는다.
    # API_UPSTREAM은 실행할 때 환경 변수로 넣는다 (예: http://192.168.122.1:18082).
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        # 포트까지 포함한 Host를 넘겨야 백엔드 CORS 검사가 같은 출처로 본다.
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    # probe용
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # 이름에 해시가 붙은 정적 파일은 오래 캐시한다.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri =404;
    }

    # index.html은 캐시하지 않는다. 캐시하면 새 배포가 바로 안 보인다.
    location = /index.html {
        add_header Cache-Control "no-cache";
        include /etc/nginx/snippets/security-headers.conf;
    }

    # SPA. /dashboard, 단축 코드(/abc123) 같은 경로는 index.html이 처리한다.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
