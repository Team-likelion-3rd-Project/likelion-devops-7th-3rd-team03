# /api는 vite.config.js의 dev proxy로 http://localhost:8080(management-service)에 전달됨.
# 배포용 빌드에서 프록시 없이 직접 붙이려면 백엔드 절대 URL로 바꿀 것.
VITE_API_BASE_URL=/api

# 카카오 개발자 콘솔의 REST API 키. 백엔드 KAKAO_CLIENT_ID와 동일 앱이어야 함.
VITE_KAKAO_CLIENT_ID=

# 카카오 콘솔에 등록한 Redirect URI. 백엔드 KAKAO_REDIRECT_URI와 반드시 동일한 값이어야
# 토큰 교환이 성공한다 (KakaoOAuthClient.exchangeToken이 이 값으로 검증함).
# 로컬: http://localhost:3000/auth/kakao/callback
# 배포(snipy.life): https://snipy.life/auth/kakao/callback
VITE_KAKAO_REDIRECT_URI=http://localhost:3000/auth/kakao/callback

# 로그인 화면에 보일 소셜 로그인 (쉼표 구분: kakao, google, naver). 비우면 kakao만 보인다.
# 주의: 구글은 리디렉션 URI에 HTTPS 또는 localhost만 허용하고 IP 주소 호스트는 거부한다.
# 온프렘 클러스터(IP·HTTP)에 올린 프론트로 구글 로그인을 시험하려면 터널로 localhost에 붙여서 접속한다.
#   ssh -N -L 3000:<워커 IP>:30080 k8s@<워커 IP>   ->   http://localhost:3000/login
# (이때 구글 콘솔과 백엔드의 redirect URI는 로컬과 같은 http://localhost:3000/auth/google/callback)
VITE_SOCIAL_PROVIDERS=kakao

# 구글·네이버도 백엔드 GOOGLE_*/NAVER_*와 같은 앱·Redirect URI를 사용해야 함.
# 구글 Redirect URI는 HTTPS 필수, 호스트에 IP 사용 불가(localhost만 예외).
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
# 네이버는 검수 전에는 개발자센터 멤버관리에 등록된 계정만 로그인 가능.
VITE_NAVER_CLIENT_ID=
VITE_NAVER_REDIRECT_URI=http://localhost:3000/auth/naver/callback