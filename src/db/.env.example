# =====================================================================
# .env.example
#
# 사용법: cp .env.example .env  후 값을 채운다.
# .env는 .gitignore에 포함되어 있다. 
#
# 운영 환경에서는 이 파일 대신 AWS Secrets Manager에서 주입한다.
# =====================================================================

# --- 접속 대상 ---
# RDS 엔드포인트 (예: shortlink-prod.abc123.ap-northeast-2.rds.amazonaws.com)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=shortlink

# --- RDS 마스터 계정 ---
# 00-database-setup.sql(DB/계정/권한 생성)을 실행할 때만 사용한다.
DB_ROOT_USER=admin
DB_ROOT_PASSWORD=<CHANGE_ME>

# --- 서비스 계정 비밀번호 ---
# 00-database-setup.sql의 <CHANGE_ME_...> 자리에 치환되어 계정이 생성된다.
# 각 서비스 애플리케이션은 APP_PASSWORD만 알면 된다.
APP_PASSWORD=<CHANGE_ME>
MIGRATOR_PASSWORD=<CHANGE_ME>
READONLY_PASSWORD=<CHANGE_ME>
