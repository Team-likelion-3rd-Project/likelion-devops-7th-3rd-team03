# 이 파일을 secrets.env 로 복사해서 값을 채운다 (secrets.env 는 .gitignore 대상이라 커밋되지 않는다).
# 따옴표 없이 KEY=값 으로 쓴다. 값 원본은 팀 비밀번호 관리자에도 보관한다.
# 이름은 클라우드(infra/k8s/overlays/*/external-secrets.yaml)의 키와 같게 맞춘다.

# mysql-secrets
MYSQL_ROOT_PASSWORD=
READONLY_PASSWORD=
DB_MIGRATOR_PASSWORD=

# mysql-secrets, management-service-secrets, redirect-service-secrets 에 같이 들어간다
DB_APP_PASSWORD=

# management-service-secrets, redirect-service-secrets (HS256 서명 키, 32바이트 이상)
JWT_SECRET=

# management-service-secrets
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
