# =====================================================================
# .env.example
#
# 사용법: cp .env.example .env 후 값을 채운다.
# .env는 .gitignore에 포함되어 있다.
# =====================================================================

# --- docker-compose가 직접 쓰는 값 ---
MYSQL_ROOT_PASSWORD=<CHANGE_ME>
MYSQL_PORT=3306
REDIS_PORT=6379
MANAGEMENT_PORT=8080
REDIRECTOR_PORT=8081
FRONTEND_PORT=3000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<CHANGE_ME>

# --- DB 계정 ---
# DB_APP_*은 두 애플리케이션이 쓰는 계정이다.
# DB_MIGRATOR_*는 Flyway/마이그레이션 전용 계정이다.
# src/db/.env를 사용해 계정을 만들었다면 두 파일의 비밀번호를 동일하게 맞춘다.
DB_NAME=shortlink
DB_APP_USER=shortlink_app
DB_APP_PASSWORD=<CHANGE_ME>
DB_MIGRATOR_USER=shortlink_migrator
DB_MIGRATOR_PASSWORD=<CHANGE_ME>
# migration 컨테이너가 읽기 전용 점검 계정을 만들 때 사용한다.
READONLY_PASSWORD=<CHANGE_ME>

# --- 공통 애플리케이션 설정 ---
# Docker Compose는 DB/Redis 호스트를 서비스명(mysql, redis)으로 자동 주입한다.
REDIRECT_CACHE_TTL=10m

# --- management-service 인증 / URL 설정 ---
# HS256 JWT 비밀키는 32바이트 이상을 사용한다.
JWT_SECRET=<CHANGE_ME_AT_LEAST_32_BYTES>
JWT_ACCESS_TOKEN_VALIDITY_SECONDS=1800
JWT_REFRESH_TOKEN_VALIDITY_SECONDS=1209600
KAKAO_CLIENT_ID=<KAKAO_REST_API_KEY>
KAKAO_CLIENT_SECRET=
# Kakao Developers 콘솔에 등록한 Redirect URI와 반드시 정확히 일치해야 한다.
# 이 값을 frontend의 VITE_KAKAO_REDIRECT_URI에도 그대로 주입한다.
KAKAO_REDIRECT_URI=http://localhost:3000/auth/kakao/callback
# 구글·네이버 로그인. CLIENT_ID가 비어 있으면 해당 로그인만 비활성화되고 앱은 그대로 기동한다.
# Redirect URI는 각 콘솔에 등록한 값과 정확히 일치해야 하고, frontend의 VITE_*_REDIRECT_URI에도 그대로 주입한다.
# 구글 Redirect URI는 HTTPS가 필수이고 호스트에 IP를 쓸 수 없다(localhost만 예외).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
# 네이버는 검수 전에는 네이버 개발자센터 멤버관리에 등록된 계정만 로그인할 수 있다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=http://localhost:3000/auth/naver/callback
# 미가입 소셜 사용자의 가입 대기 세션 유효 시간
SIGNUP_SESSION_TTL=15m
SHORT_URL_BASE_URL=http://localhost:8081
# 프론트에서 API를 호출할 수 있도록 허용할 origin (콤마로 여러 개 지정 가능)
# Compose로 띄울 때는 기본값(http://localhost:3000)을 쓰고, 로컬에서 bootRun으로 직접 실행할 때만 읽힌다
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- frontend 설정 ---
# /api는 frontend 컨테이너의 Vite proxy를 거쳐 management-service로 전달된다.
# VITE_ 값은 브라우저에 노출되므로 비밀값을 넣지 말 것.
VITE_API_BASE_URL=/api
# 로그인 버튼을 보여줄 provider (콤마 구분 소문자, 예: kakao,google,naver)
# 백엔드에 CLIENT_ID를 설정한 provider만 넣는다.
VITE_SOCIAL_PROVIDERS=kakao

# --- redirect-service 설정 ---
SPRING_PROFILES_ACTIVE=local
# 클릭 이벤트 기록 방식: log(온프렘·로컬, 파일 기록 → Fluent Bit 수집) | firehose(AWS)
CLICK_EVENT_SINK=log
REDIRECT_LOG_LEVEL=DEBUG
VISITOR_COOKIE_SECURE=false
VISITOR_COOKIE_NAME=visitor_id
VISITOR_COOKIE_MAX_AGE=365d
TRUST_FORWARDED_FOR=true
REALTIME_STATS_RETENTION=3d
REALTIME_STATS_FLUSH_INTERVAL=5s
REALTIME_STATS_BUFFER_CAPACITY=100000

# --- 온프렘 클릭 로그 저장소 (SeaweedFS, S3 호환) ---
S3_ACCESS_KEY=<CHANGE_ME>
S3_SECRET_KEY=<CHANGE_ME>
S3_BUCKET=snipy-click-logs
S3_PORT=8333
# Fluent Bit 업로드 주기. 운영 기준 5m(Firehose와 동일), 로컬 테스트는 1m 권장
S3_UPLOAD_TIMEOUT=5m
